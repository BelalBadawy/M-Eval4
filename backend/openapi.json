    "/api/v1/imports/dry-run": {
      "post": {
        "tags": [
          "Imports"
        ],
        "summary": "Validate and dry-run user import file, staging rows in database",
        "operationId": "DryRunImport",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "allOf": [
                  {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "format": "binary"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "duplicateStrategy": {
                        "type": "integer"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "commitPolicy": {
                        "type": "integer"
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
