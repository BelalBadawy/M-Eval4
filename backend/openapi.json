        "summary": "Query immutable audit logs with pagination and filtering",
        "operationId": "GetAuditLogs",
        "parameters": [
          {
            "name": "actorUserId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid",
              "default": null
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "default": null
            }
          },
          {
            "name": "entityType",
            "in": "query",
            "schema": {
              "type": "string",
              "default": null
            }
          },
          {
            "name": "entityId",
